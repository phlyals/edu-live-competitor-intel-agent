+        return task
+    from v3_task_control import task_summary
+
+    error_type = str(task.get('error_type') or '')
+    dedupe = hashlib.sha256(
+        f"{task_id}:{task['status']}:{error_type}:{task.get('attempts') or 0}".encode()
+    ).hexdigest()[:32]
+    enqueue_outbox(
+        object_type='task_notification', object_id=task_id, destination='feishu_chat',
+        payload={
+            'task_id': task_id,
+            'chat_id': input_data['chat_id'],
+            'source_message_id': source_message,
+            'text': task_summary(task),
+            'idempotency_key': dedupe,
+            'profile_id': PROFILE_ID,
+        },
+    )
+    return task
 
 
