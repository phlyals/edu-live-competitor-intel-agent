+def notify_task_status(task_id: str, input_data: dict) -> dict:
+    """Send concise user copy while retaining technical errors in PostgreSQL."""
+    with connect() as conn:
+        task = dict(conn.execute('SELECT * FROM tasks WHERE task_id=?', (task_id,)).fetchone())
