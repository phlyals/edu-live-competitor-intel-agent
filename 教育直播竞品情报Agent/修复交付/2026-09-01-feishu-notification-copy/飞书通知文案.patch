@@ -0,0 +1,204 @@
+#!/usr/bin/env python3
+"""Plain-language Feishu copy for Runtime V3 task notifications."""
+from __future__ import annotations
+
+import json
+import re
+from datetime import datetime
+from zoneinfo import ZoneInfo
+
+
+STATUS_HEADINGS = {
+    "RECEIVED": "📥 已收到",
+    "RUNNING": "⏳ 正在处理",
+    "RETRY_WAIT": "⏳ 正在处理",
+    "DELIVERY_PENDING": "⏳ 正在保存结果",
+    "WAITING_HUMAN": "⚠️ 需要你操作",
+    "WAITING_TOOL": "⚠️ 暂时无法继续",
+    "WAITING_IDENTITY": "⚠️ 需要重新确认直播间",
+    "PARTIAL_SUCCESS": "⚠️ 已完成部分处理",
+    "FAILED_FINAL": "❌ 本次未完成",
+    "COMPLETE": "✅ 处理完成",
+    "SUPERSEDED": "ℹ️ 已由新任务替代",
+}
+
+STEP_COPY = {
+    "INGRESS": "正在识别商品链接",
+    "PRODUCT_RESOLVED": "已识别商品，正在查找同行直播间",
+    "SCANNING": "正在查找同行直播间",
+    "IDENTITY_CLOSURE": "正在确认同行账号与直播间",
+    "LOCAL_COMMIT": "正在保存扫描结果",
+    "OUTBOX": "正在写入业务工作台",
+    "DELIVERY": "正在写入业务工作台",
+}
+
+
+def product_key(task: dict) -> str:
+    try:
+        data = json.loads(task.get("input_json") or "{}")
+    except (TypeError, json.JSONDecodeError):
+        data = {}
+    explicit = (data.get("product_resolution") or {}).get("resolved_input") or task.get("product_id")
+    if explicit:
+        return str(explicit).removeprefix("douyin:")
+    raw = str(data.get("content") or "")
+    number = re.search(r"(?<!\d)\d{10,22}(?!\d)", raw)
+    return number.group(0) if number else "待识别"
+
+
+def ingress_ack_text() -> str:
+    return "\n".join((
+        "📥 已收到商品链接",
+        "正在识别商品并查找相关同行直播间。",
+        "有结果后我会继续通知你。",
+    ))
+
+
+def _login_expired(error_type: str, error_message: str) -> bool:
+    if error_type == "BUYIN_LOGIN_REQUIRED":
+        return True
+    text = error_message.lower()
+    return error_type == "TABBIT_ACQUISITION_BLOCKED" and any(
+        marker in text for marker in ("passport", "/logout", "login", "登录")
+    )
+
+
+def plain_reason(error_type: str | None, error_message: str | None) -> str:
+    kind = str(error_type or "")
+    detail = str(error_message or "")
+    if _login_expired(kind, detail):
+        return "精选联盟登录状态已失效，暂时无法查找同行直播间。"
+    if kind in {"TABBIT_TAB_AMBIGUOUS", "TABBIT_WINDOW_AMBIGUOUS"}:
+        return "系统无法确定应使用哪个精选联盟页面。"
+    if kind == "TABBIT_ACQUISITION_BLOCKED":
+        return "精选联盟页面暂时无法正常读取。"
+    if kind == "STORAGE_UNAVAILABLE":
+        return "录制硬盘当前未连接。"
+    if kind == "STORAGE_LOW_SPACE":
+        return "录制硬盘剩余空间不足。"
+    if kind == "QR_IDENTITY_UNRESOLVED":
+        return "同行账号与直播间的对应关系暂时无法确认。"
+    if kind in {"PRODUCT_LINK_RESOLUTION_FAILED", "INVALID_COMMAND"}:
+        return "没有识别出有效的商品链接或商品编号。"
+    if kind in {"SCAN_DATA_CHANGED", "SCAN_PAGE_NOT_READY", "SCAN_TEMPORARY_HTTP_ERROR"}:
+        return "精选联盟页面数据暂时不稳定，本次没有完整读取。"
+    if kind in {"COMMITTED_EVIDENCE_MISSING", "RESULT_MISSING", "INVALID_SCANNER_OUTPUT"}:
+        return "本次扫描结果保存不完整。"
+    if kind == "IDENTITY_OR_EVIDENCE_NOT_VERIFIED":
+        return "同行账号与直播间的对应关系尚未确认完整。"
+    if kind in {"IDENTITY_CONFIGURATION_ERROR", "IDENTITY_CONFLICT", "UNAUTHORIZED"}:
+        return "账号配置存在冲突，当前无法继续处理。"
+    if kind in {"FEISHU_ACK_FAILED", "DELIVERY_FAILED"}:
+        return "结果暂时没有成功写入飞书。"
+    return "本次处理暂时没有完成。"
+
+
+def _action_text(task: dict) -> str | None:
+    status = str(task.get("status") or "")
+    error_type = str(task.get("error_type") or "")
+    error_message = str(task.get("error_message") or "")
+    if _login_expired(error_type, error_message):
+        return "请重新登录巨量百应或精选联盟，然后回复“继续处理”。不用重新发送商品链接。"
+    if error_type in {"TABBIT_TAB_AMBIGUOUS", "TABBIT_WINDOW_AMBIGUOUS"}:
+        return "请只保留一个已登录的精选联盟页面，然后回复“继续处理”。"
+    if error_type == "STORAGE_UNAVAILABLE":
+        return "请连接录制硬盘，然后回复“继续处理”。"
+    if error_type == "STORAGE_LOW_SPACE":
+        return "请清理录制硬盘空间，然后回复“继续处理”。"
+    if error_type in {"PRODUCT_LINK_RESOLUTION_FAILED", "INVALID_COMMAND"}:
+        return "请重新发送有效的抖音商品分享链接。"
+    if error_type in {"IDENTITY_CONFIGURATION_ERROR", "IDENTITY_CONFLICT", "UNAUTHORIZED"}:
+        return "这个问题不能通过重复操作解决，请联系维护人员检查账号配置。"
+    if status == "RETRY_WAIT":
+        return "系统会自动继续处理，你不用重新发送商品链接。"
+    if status in {"WAITING_HUMAN", "WAITING_TOOL", "WAITING_IDENTITY", "FAILED_FINAL", "PARTIAL_SUCCESS"}:
+        return "已有进度会保留。准备好后回复“继续处理”，不用重新发送商品链接。"
+    return None
+
+
+def _progress_text(task: dict) -> str:
+    status = str(task.get("status") or "")
+    if status == "COMPLETE":
+        return "同行账号和直播间已整理完成"
+    step = str(task.get("current_step") or "")
+    progress = STEP_COPY.get(step, "等待处理")
+    if status in {"WAITING_HUMAN", "FAILED_FINAL"} and step == "PRODUCT_RESOLVED":
+        return "已识别商品，尚未完成同行直播间查找"
+    return progress
+
+
+def _beijing_timestamp(value: str | None) -> str | None:
+    if not value:
+        return None
+    try:
+        stamp = datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone(ZoneInfo("Asia/Shanghai"))
+    except ValueError:
+        return None
+    return stamp.strftime("%Y-%m-%d %H:%M") + "（北京时间）"
+
+
+def task_summary(task: dict, *, include_task_id: bool = False) -> str:
+    status = str(task.get("status") or "")
+    lines = [
+        STATUS_HEADINGS.get(status, "ℹ️ 任务状态更新"),
+        f"商品：{product_key(task)}",
+        f"当前进度：{_progress_text(task)}",
+    ]
+    if include_task_id:
+        lines.append(f"任务编号：{task.get('task_id') or '未知'}")
+    if status == "COMPLETE":
+        lines.extend((
+            "同行信息已写入业务工作台。",
+            "后续发现开播会自动录制。",
+        ))
+    elif status in {"WAITING_HUMAN", "WAITING_TOOL", "WAITING_IDENTITY", "RETRY_WAIT", "FAILED_FINAL", "PARTIAL_SUCCESS"}:
+        if task.get("error_type") or status != "RETRY_WAIT":
+            lines.append(f"原因：{plain_reason(task.get('error_type'), task.get('error_message'))}")
+        action = _action_text(task)
+        if action:
+            lines.append(action)
+    elif status in {"RECEIVED", "RUNNING", "DELIVERY_PENDING"}:
+        lines.append("任务正在后台处理，有结果后我会继续通知你。")
+    timestamp = _beijing_timestamp(task.get("updated_at"))
+    if timestamp:
+        lines.append(f"更新时间：{timestamp}")
+    return "\n".join(lines)
+
+
+def resume_text(task: dict) -> str:
+    return "\n".join((
+        "✅ 已继续处理",
+        f"商品：{product_key(task)}",
+        "系统会从上次中断处继续，不会重复创建任务。",
+        "有结果后我会继续通知你。",
+    ))
+
+
+def blocked_resume_text(task: dict) -> str:
+    return "\n".join((
+        "⚠️ 暂时无法继续",
+        f"商品：{product_key(task)}",
+        f"原因：{plain_reason(task.get('error_type'), task.get('error_message'))}",
+        "这个问题不能通过重复操作解决，请联系维护人员检查账号配置。",
+    ))
+
+
+def ambiguous_tasks_text(tasks: list[dict]) -> str:
+    lines = [
+        "⚠️ 有多个不同商品任务等待处理",
+        "请按对应商品编号回复，例如“继续 3839136509492068370”：",
+    ]
+    for task in tasks:
+        product = product_key(task)
+        lines.append(f"商品 {product}：回复“继续 {product}”")
+    return "\n".join(lines)
+
+
+def completion_text(product_id: str | None) -> str:
+    product = str(product_id or "待识别").removeprefix("douyin:")
+    return "\n".join((
+        "✅ 同行直播间查找完成",
+        f"商品：{product}",
+        "同行账号和直播间已整理并写入业务工作台。",
+        "后续发现开播会自动录制。",
+    ))
