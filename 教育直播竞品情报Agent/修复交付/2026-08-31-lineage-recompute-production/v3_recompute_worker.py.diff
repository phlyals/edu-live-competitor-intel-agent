+def once(*, max_jobs: int = 1) -> dict:
+    init_db()
+    with connect() as conn:
+        exhausted = reconcile_exhausted(conn, RECOMPUTE)
+    outcomes = {
+        "claimed": 0, "candidate_created": 0, "obsolete": 0,
+        "retry_wait": 0, "failed_final": 0, "lease_lost": 0,
+    }
+    for _ in range(max(1, int(max_jobs))):
+        with connect() as conn:
+            job = claim_next(
+                conn, RECOMPUTE, worker_id(),
+                lease_seconds=RECOMPUTE_LEASE_SECONDS,
+            )
+        if not job:
+            break
+        outcomes["claimed"] += 1
+        result = process_request(job)
+        outcomes["candidate_created"] += int(result == "CANDIDATE_CREATED")
+        outcomes["obsolete"] += int(result == "OBSOLETE")
+        outcomes["retry_wait"] += int(result == "RETRY_WAIT")
+        outcomes["failed_final"] += int(result == "FAILED_FINAL")
+        outcomes["lease_lost"] += int(result == "LEASE_LOST")
+    candidates = reconcile_candidates()
+    result = {
+        **outcomes, **{f"candidate_{k}": v for k, v in candidates.items()},
+        "expired_exhausted": exhausted, "checked_at": utc_now(),
+    }
+    healthy = not any((
+        outcomes["retry_wait"], outcomes["failed_final"],
+        outcomes["lease_lost"], candidates["failed"], exhausted,
+    ))
+    upsert_heartbeat(
+        "recompute-v3", "READY" if healthy else "DEGRADED",
+        result, success=healthy,
+    )
     return result
 
