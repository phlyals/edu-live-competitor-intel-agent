+def finite_number(value) -> float | None:
+    """Return a finite float, rejecting booleans and JSON NaN/Infinity."""
+    if isinstance(value, bool):
+        return None
+    try:
+        number = float(value)
+    except (TypeError, ValueError):
+        return None
+    return number if math.isfinite(number) else None
