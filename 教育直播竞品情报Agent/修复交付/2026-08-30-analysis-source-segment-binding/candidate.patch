+            "source_segment_id": source_segment_id,
+            "start": start,
+            "end": end,
+            "text": source_text,
+            "analysis_text": analysis_text,
+            "content_digest": content_digest,
+            "line": f"[{source_segment_id}] {analysis_text}",
+        })
+    return bound
+
