    "query_sql": "SELECT\n  s.session_id,\n  s.started_at,\n  s.status AS session_status,\n  s.metadata_json,\n  j.status AS recording_job_status,\n  j.restart_count,\n  j.partial_dir,\n  j.completed_dir,\n  j.updated_at AS recording_job_updated_at\nFROM public.live_sessions AS s\nLEFT JOIN public.recording_jobs AS j ON j.session_id = s.session_id\nWHERE s.started_at::timestamptz >= %s::timestamptz\n  AND s.status = %s\nORDER BY s.started_at::timestamptz ASC",
    "dsn_persisted": false
  },
