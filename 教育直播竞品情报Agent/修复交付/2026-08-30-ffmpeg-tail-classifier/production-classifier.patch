+def ffmpeg_tail_error_codes(value: str | list[str]) -> list[str]:
+    """Return stable diagnostic codes without retaining stderr content."""
+    lines = value if isinstance(value, list) else (value or "").splitlines()
+    codes: list[str] = []
+    for raw_line in lines:
+        line = redact_stream_urls(str(raw_line))
+        matched = False
+        for code, pattern in (*_FFMPEG_INTEGRITY_PATTERNS, *_FFMPEG_NETWORK_PATTERNS):
+            if pattern.search(line):
+                matched = True
+                if code not in codes:
+                    codes.append(code)
+        if not matched and re.search(r"\b(?:error|failed|fatal)\b", line, re.I):
+            if "UNKNOWN_FFMPEG_ERROR" not in codes:
+                codes.append("UNKNOWN_FFMPEG_ERROR")
+    return codes
+
+
+def classify_ffmpeg_tail(value: str | list[str]) -> str:
+    """Classify a bounded FFmpeg stderr tail for chunk acceptance."""
+    return classify_ffmpeg_error_codes(ffmpeg_tail_error_codes(value))
+
+
+def classify_ffmpeg_error_codes(codes: list[str]) -> str:
+    """Classify already-sanitized stable codes, including cumulative history."""
+    integrity_codes = {code for code, _ in _FFMPEG_INTEGRITY_PATTERNS}
+    if any(code in integrity_codes or code == "UNKNOWN_FFMPEG_ERROR" for code in codes):
+        return "INTEGRITY_ERROR"
+    if codes:
+        return "NETWORK_WARNING"
+    return "BENIGN"
 
 
