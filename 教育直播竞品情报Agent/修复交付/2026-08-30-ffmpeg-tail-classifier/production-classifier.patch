+_FFMPEG_INTEGRITY_PATTERNS = (
+    ("STREAM_PREMATURE_END", re.compile(r"stream ends? prematurely|premature end", re.I)),
+    ("SEGMENT_SKIPPED", re.compile(r"failed too many times, skipping|skipping \d+ segments ahead, expired from playlists", re.I)),
