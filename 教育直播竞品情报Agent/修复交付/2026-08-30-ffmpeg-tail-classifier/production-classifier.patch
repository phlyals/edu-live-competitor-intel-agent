+    ("UNABLE_SEEK_PACKET", re.compile(r"unable to seek to the next packet", re.I)),
+)
+
+_FFMPEG_NETWORK_PATTERNS = (
+    ("HTTP_4XX", re.compile(r"http error 4\d\d|server returned 4\d\d", re.I)),
+    ("HTTP_5XX", re.compile(r"http error 5\d\d|server returned 5\d\d", re.I)),
+    ("NETWORK_TIMEOUT", re.compile(r"(?:operation )?timed out|timeout", re.I)),
+    ("DNS_FAILURE", re.compile(r"failed to resolve hostname|name or service not known|nodename nor servname provided", re.I)),
+    ("NETWORK_EOF", re.compile(r"error(?:=| reading http response: )end of file", re.I)),
+    ("NETWORK_CONNECTION", re.compile(r"connection (?:reset|refused|closed)|network is unreachable", re.I)),
+    ("RECONNECT_ATTEMPT", re.compile(r"will reconnect", re.I)),
+)
