+    ("DEMUX_IO_ERROR", re.compile(r"error during demuxing:\s*(?:input/output error|i/o error)", re.I)),
+    ("MUX_WRITE_ERROR", re.compile(r"error (?:writing|closing) (?:trailer|file)|av_interleaved_write_frame", re.I)),
+    ("INVALID_DATA", re.compile(r"invalid data found when processing input", re.I)),
+    ("PACKET_MISMATCH", re.compile(r"\bpacket mismatch\b", re.I)),
+    ("PACKET_CORRUPT", re.compile(r"\bpacket corrupt\b|\bcorrupt input packet\b", re.I)),
