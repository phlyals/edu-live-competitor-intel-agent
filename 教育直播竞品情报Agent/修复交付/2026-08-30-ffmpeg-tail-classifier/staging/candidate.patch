 def redact_stream_urls(value: str) -> str:
     return re.sub(r"https?://\S+", "<stream-url>", value or "")
+
+
+# Stable, non-sensitive diagnostics for FFmpeg stderr.  Raw signed URLs must
+# never be used as machine-readable error data.
+_FFMPEG_INTEGRITY_PATTERNS = (
+    ("STREAM_PREMATURE_END", re.compile(r"stream ends prematurely", re.I)),
+    ("SEGMENT_SKIPPED", re.compile(r"segment .+ failed too many times|skipping", re.I)),
+    ("SEGMENT_OPEN_FAILED", re.compile(r"failed to open segment", re.I)),
+    ("PLAYLIST_RELOAD_FAILED", re.compile(r"failed to reload playlist", re.I)),
+    ("INPUT_OPEN_FAILED", re.compile(r"error (?:when loading first segment|opening input(?: file| files)?)", re.I)),
+    ("DEMUX_ERROR", re.compile(r"error during demuxing", re.I)),
+    ("MUX_WRITE_ERROR", re.compile(r"error (?:writing|closing) (?:trailer|file)|av_interleaved_write_frame", re.I)),
+    ("CORRUPT_MEDIA", re.compile(r"\bcorrupt(?:ed|ion)?\b|invalid data found", re.I)),
+    ("TIMESTAMP_DISCONTINUITY", re.compile(r"non[- ]monoton(?:ic|ous) dts", re.I)),
+)
+
+_FFMPEG_NETWORK_PATTERNS = (
+    ("HTTP_4XX", re.compile(r"http error 4\d\d|server returned 4\d\d", re.I)),
+    ("HTTP_5XX", re.compile(r"http error 5\d\d|server returned 5\d\d", re.I)),
+    ("NETWORK_TIMEOUT", re.compile(r"(?:operation )?timed out|timeout", re.I)),
+    ("NETWORK_EOF", re.compile(r"error(?:=| reading http response: )end of file", re.I)),
+    ("NETWORK_CONNECTION", re.compile(r"connection (?:reset|refused|closed)|network is unreachable", re.I)),
+    ("RECONNECT_ATTEMPT", re.compile(r"will reconnect", re.I)),
+)
+
+
+def ffmpeg_tail_error_codes(value: str | list[str]) -> list[str]:
+    """Return stable diagnostic codes without retaining stderr content."""
+    lines = value if isinstance(value, list) else (value or "").splitlines()
+    codes: list[str] = []
+    for raw_line in lines:
+        line = redact_stream_urls(str(raw_line))
+        matched = False
+        for code, pattern in (*_FFMPEG_INTEGRITY_PATTERNS, *_FFMPEG_NETWORK_PATTERNS):
+            if pattern.search(line):
+                matched = True
+                if code not in codes:
+                    codes.append(code)
+        if not matched and re.search(r"\b(?:error|failed|fatal)\b", line, re.I):
+            if "UNKNOWN_FFMPEG_ERROR" not in codes:
+                codes.append("UNKNOWN_FFMPEG_ERROR")
+    return codes
+
+
+def classify_ffmpeg_tail(value: str | list[str]) -> str:
+    """Classify a bounded FFmpeg stderr tail for chunk acceptance."""
+    codes = ffmpeg_tail_error_codes(value)
+    integrity_codes = {code for code, _ in _FFMPEG_INTEGRITY_PATTERNS}
+    if any(code in integrity_codes or code == "UNKNOWN_FFMPEG_ERROR" for code in codes):
+        return "INTEGRITY_ERROR"
+    if codes:
+        return "NETWORK_WARNING"
+    return "BENIGN"
 
 
