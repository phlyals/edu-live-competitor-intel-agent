# Recorder work-in-progress fragments (a trailing .partial bypasses *.ts)
*.partial
*.partial.*

# Credentials and machine-local configuration
.env
.env.*
auth.json
credentials.json
secrets.json
*.pem
*.key

# Captured production profile/session snapshots may contain credentials or chat data
**/修改前/config.yaml
**/修改前/sessions.json
